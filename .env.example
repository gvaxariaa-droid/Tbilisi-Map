# ---- Server (copy to server/.env for local development) --------------------
NODE_ENV=development
PORT=8080

# PostgreSQL with PostGIS. Local docker-compose value shown.
DATABASE_URL=postgres://tpm:tpm-local-password@localhost:5432/tpm
# true = use TLS to the database (most external/managed connection strings need it)
DATABASE_SSL=false
# true = also verify the database certificate (recommended where your provider supports it)
DATABASE_SSL_STRICT=false
# Apply pending migrations at startup (default true)
MIGRATE_ON_START=true

# Session signing secret, at least 32 characters:  openssl rand -hex 32
JWT_SECRET=replace-me-with-output-of-openssl-rand-hex-32
SESSION_DAYS=7

# First administrator, created only when the users table is empty.
# Remove ADMIN_PASSWORD from the environment after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Photo storage: "local" (disk, needs a persistent volume in production) or "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# For STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO...). Keep the bucket private.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=10
MAX_PHOTOS_PER_LAND=30

# Origins the browser may load map tiles from (Content-Security-Policy).
# Must cover the hosts in the client's VITE_*_TILE_URL settings.
TILE_ORIGINS=https://tile.openstreetmap.org,https://server.arcgisonline.com,https://services.arcgisonline.com
